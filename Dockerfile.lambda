FROM mcr.microsoft.com/playwright:v1.62.1-noble

WORKDIR /app
ENV LAMBDA_TASK_ROOT=/app

# Install build tools required by aws-lambda-ric
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        cmake \
        g++ \
        make \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package*.json ./

# Install dependencies, including aws-lambda-ric
RUN npm ci

# Copy TypeScript configuration and application
COPY tsconfig.json ./
COPY src ./src
COPY tests ./tests
COPY playwright.config.ts ./

# Compile TypeScript
RUN npm run build

# Lambda Runtime Interface Client
ENTRYPOINT ["/app/node_modules/.bin/aws-lambda-ric"]

# Lambda handler
CMD ["dist/src/handler.handler"]